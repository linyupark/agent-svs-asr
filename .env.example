# Copy to .env and edit. compose.yml reads these.

# --- required ---------------------------------------------------------------
# Bearer / X-API-Key token(s). Comma separated for rotation, e.g. key-new,key-old
ASR_API_KEY=change-me-please

# --- networking ------------------------------------------------------------
ASR_BIND_IP=0.0.0.0
ASR_HOST_PORT=8001

# --- performance (8C/16T 5825U: 4 threads x 3 concurrent ≈ 12 of 16 threads) --
ASR_NUM_THREADS=4
ASR_MAX_CONCURRENCY=3
ASR_QUEUE_TIMEOUT=120
# 900 = free the model after 15 min of no traffic; next request reloads in ~1 s
ASR_IDLE_UNLOAD_SEC=900

# --- models ----------------------------------------------------------------
# 1 = 启动时若 ./models 缺文件则自动下载一次（约 230 MB）；0 = 缺就报错，绝不联网
ASR_AUTO_DOWNLOAD=1

# --- limits ----------------------------------------------------------------
ASR_MAX_UPLOAD_MB=300
ASR_MAX_AUDIO_SEC=21600
ASR_WHOLE_MAX_SEC=30

# --- behaviour -------------------------------------------------------------
ASR_LANGUAGE=auto
ASR_USE_ITN=1
ASR_MODEL_NAME=sensevoice
ASR_SEG_PAD=0.15
ASR_CUE_MAX_CHARS=34
ASR_CUE_MAX_SEC=9
ASR_LOG_LEVEL=info

# --- optional --------------------------------------------------------------
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
TZ=Asia/Shanghai
